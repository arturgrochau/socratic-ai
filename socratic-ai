#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
API_HOST="127.0.0.1"
API_PORT="8000"
FRONTEND_PORT="8501"
OPEN_BROWSER="true"
RELOAD_API="true"

for arg in "$@"; do
  case "$arg" in
    --no-open)
      OPEN_BROWSER="false"
      ;;
    --no-reload)
      RELOAD_API="false"
      ;;
    *)
      echo "Unknown argument: $arg"
      echo "Usage: ./socratic-ai [--no-open] [--no-reload]"
      exit 1
      ;;
  esac
done

if [ ! -x "$PYTHON_BIN" ]; then
  echo "Missing virtual environment python at $PYTHON_BIN"
  echo "Create it first: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  exit 1
fi

if command -v lsof >/dev/null 2>&1; then
  if lsof -iTCP:"$API_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
    echo "Port $API_PORT is already in use. Stop existing API process first."
    exit 1
  fi
  if lsof -iTCP:"$FRONTEND_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
    echo "Port $FRONTEND_PORT is already in use. Stop existing Streamlit process first."
    exit 1
  fi
fi

cleanup() {
  set +e
  if [ -n "${API_PID:-}" ] && kill -0 "$API_PID" >/dev/null 2>&1; then
    kill "$API_PID" >/dev/null 2>&1
  fi
  if [ -n "${STREAMLIT_PID:-}" ] && kill -0 "$STREAMLIT_PID" >/dev/null 2>&1; then
    kill "$STREAMLIT_PID" >/dev/null 2>&1
  fi
  wait >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

cd "$ROOT_DIR"

API_CMD=("$PYTHON_BIN" -m uvicorn main:app --host "$API_HOST" --port "$API_PORT")
if [ "$RELOAD_API" = "true" ]; then
  API_CMD+=(--reload)
fi

echo "Starting API on http://$API_HOST:$API_PORT"
"${API_CMD[@]}" &
API_PID=$!

echo "Starting Streamlit on http://$API_HOST:$FRONTEND_PORT"
"$PYTHON_BIN" -m streamlit run frontend/app.py --server.port "$FRONTEND_PORT" --server.address "$API_HOST" &
STREAMLIT_PID=$!

for _ in $(seq 1 90); do
  if curl -fsS "http://$API_HOST:$API_PORT/health" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

for _ in $(seq 1 90); do
  if curl -fsS "http://$API_HOST:$FRONTEND_PORT" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

echo ""
echo "Socratic AI is running:"
echo "- API:       http://$API_HOST:$API_PORT"
echo "- Frontend:  http://$API_HOST:$FRONTEND_PORT"
echo ""
echo "Use Ctrl+C to stop both services together."

if [ "$OPEN_BROWSER" = "true" ] && command -v open >/dev/null 2>&1; then
  open "http://$API_HOST:$FRONTEND_PORT" >/dev/null 2>&1 || true
fi

if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
  wait -n "$API_PID" "$STREAMLIT_PID"
else
  while true; do
    if ! kill -0 "$API_PID" >/dev/null 2>&1; then
      wait "$API_PID" || true
      break
    fi
    if ! kill -0 "$STREAMLIT_PID" >/dev/null 2>&1; then
      wait "$STREAMLIT_PID" || true
      break
    fi
    sleep 1
  done
fi
