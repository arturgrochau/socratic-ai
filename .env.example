# Copy to .env. Required only if you use the OpenAI API (the default).
# You can also set everything below from the in-app Settings page at runtime —
# those choices are saved to your user config dir and override these defaults.
OPENAI_API_KEY=

# Storage / infrastructure (not runtime-switchable)
DATABASE_URL=sqlite:///./app.db
CHROMA_PERSIST_DIR=./chroma_data
USER_ID_HEADER=X-User-ID
ENABLE_COST_LOGGING=true
CACHE_PROCESSED_SOURCES=true
DEPLOY_ENV=production

# Providers (openai | ollama). Switchable later in the Settings page.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
WHISPER_PROVIDER=openai
OLLAMA_HOST=http://localhost:11434

# Models
GENERATION_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini
RETRIEVAL_MODEL=text-embedding-3-small

# Auxiliary model for cheap high-volume passes (ledger extraction, audits)
AUX_USE_LOCAL=false
AUX_MODEL=gpt-4o-mini
AUX_LOCAL_MODEL=llama3.1:8b
