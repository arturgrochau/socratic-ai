# Copy to .env. Everything here is optional — the app runs fully local by
# default (Ollama + on-device transcription, no API key). All of it is also
# switchable at runtime from the in-app Settings page; those choices persist
# to your user config dir and override these bootstrap defaults.

# Only needed for API mode (or WHISPER_PROVIDER=openai).
OPENAI_API_KEY=

# Storage / infrastructure (not runtime-switchable)
# Runtime data (SQLite, vectors, uploads, logs) defaults to your user data dir
# (macOS: ~/Library/Application Support/socratic-ai). Override the whole dir:
# SOCRATIC_DATA_DIR=~/socratic-data
# ...or individual locations:
# DATABASE_URL=sqlite:///./app.db
# CHROMA_PERSIST_DIR=./chroma_data
USER_ID_HEADER=X-User-ID
ENABLE_COST_LOGGING=true
CACHE_PROCESSED_SOURCES=true
DEPLOY_ENV=production

# Providers. LLM/embeddings: openai | ollama. Transcription: local | openai | none.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
WHISPER_PROVIDER=local
OLLAMA_HOST=http://localhost:11434

# Models — applied to the bundle the matching provider selects (local bundle
# when the provider is ollama, hosted bundle when it is openai).
GENERATION_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
CHAT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
RETRIEVAL_MODEL=nomic-embed-text

# Auxiliary model for the high-volume extraction passes.
AUX_MODEL=gpt-4o-mini
AUX_LOCAL_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# API mode only: route aux passes to a reachable local daemon anyway.
AUX_USE_LOCAL=false

# Local performance knobs (defaults shown).
# SOCRATIC_LOCAL_PARALLEL=2            # concurrent requests to the Ollama daemon
# SOCRATIC_OLLAMA_NUM_CTX=16384        # per-call context window
# SOCRATIC_OLLAMA_NUM_CTX_LARGE=16384  # consolidation/synthesis tier — keep equal to
#                                      # NUM_CTX unless you have free memory: a larger
#                                      # tier forces a runner reload mid-pipeline and can
#                                      # stall when other models are resident
# SOCRATIC_OLLAMA_KEEP_ALIVE=30m       # keep the model resident between stages
# SOCRATIC_OLLAMA_TIMEOUT_SECONDS=600
# SOCRATIC_PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# SOCRATIC_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Recommended Ollama daemon env (set via `launchctl setenv` / Ollama config):
#   OLLAMA_NUM_PARALLEL=2  OLLAMA_FLASH_ATTENTION=1  OLLAMA_KV_CACHE_TYPE=q8_0
